# SmartAI - Environment Configuration Template
# Copy this file to .env for local testing, or add these variables directly in Vercel Project Settings.

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=smartai-production-secret-key-change-this-in-production

# Neon PostgreSQL Database Connection
# Retrieve from Neon Console (https://console.neon.tech) -> Connection Details -> Pooled connection
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-fog-a1b2c3d4-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Groq Cloud API
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Generation Parameters
MAX_NEW_TOKENS=1024
TEMPERATURE=0.7
TOP_P=0.9
REPETITION_PENALTY=1.1
